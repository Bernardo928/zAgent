  "description": "Workspace desktop: Claude Code principal + painel de monitoramento para cada agente paralelo.",
  "main": "dist/main.js",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
